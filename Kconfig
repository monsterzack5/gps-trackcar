menu "GPS Tracker"

config TRACCAR_HOSTNAME
    string "Server Hostname"
    depends on NETWORKING
    help
        Url for traccar server, eg traccar.example.com

config TRACCAR_PORT
    string "Port"
    depends on NETWORKING
    help
        Traccar Port


config DNS_CACHE_ENTRIES 
    int "Cache entries"
    range 1 10
    default 3
    help
        amount of URL's DNS queries to cache

config NETWORK_PACKET_SIZE
    int "Packet Size"
    range 512 4096
    default 512
    help
        size of a network packet that will be queued

menu "GPS Settings"

config GPS_TIMEOUT_SECONDS
	int "GPS fix timeout"
	range 120 1800
	default 600
	help
	  Time in seconds to wait for a GPS fix before restarting.
	  If no fix is obtained within this time, GPS will be stopped
	  and restarted after the restart delay.

config GPS_RESTART_DELAY_SECONDS
	int "GPS restart delay"
	range 10 1800
	default 600
	help
	  Time in seconds to wait before restarting GPS after a timeout.
	  This delay allows the modem to cool down and potentially
	  improve conditions for the next fix attempt.

config GPS_PACKET_RATE_LIMIT_MILLISECONDS
    int "rate limit"
    default 30000
    help
      The minium amount of time between sending up GPS packets

endmenu

menu "SD Card"

config TRACKCAR_ENABLE_SD_CARD
	bool "Enable SD card logging"
	default n
	select DISK_ACCESS
	select DISK_DRIVERS
	select DISK_DRIVER_SDMMC
	select FILE_SYSTEM
	select FAT_FILESYSTEM_ELM
	select FILE_SYSTEM_MKFS
	select FS_FATFS_EXFAT
	depends on !NRF_MODEM_LIB_TRACE
	help
	  Enable logging to SD card. Note that this requires SD card
	  hardware and is incompatible with modem trace.

endmenu


config TRACCAR_DEFAULT_LOG_LEVEL
    int "Level"
    range 0 4
    default 3
    help
        default log level for project

endmenu



menu "Zephyr Kernel"
source "Kconfig.zephyr"
endmenu

module = Tracker
module-str = GPS Tracker Kconfig
source "${ZEPHYR_BASE}/subsys/logging/Kconfig.template.log_config"
